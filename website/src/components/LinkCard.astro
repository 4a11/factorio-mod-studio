---
// A card that is one link, usually to a place on GitHub: a title with an arrow and a line of text.
interface Props {
  href: string;
  title: string;
  text: string;
}
const { href, title, text } = Astro.props;
---

<a class="link-card" href={href} rel="noopener">
  <span class="title">
    {title}
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
      <path d="M5 3h8v8M13 3L3 13" fill="none" stroke="currentColor" stroke-width="1.6"></path>
    </svg>
  </span>
  <span class="text">{text}</span>
</a>

<style>
  .link-card {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-surface);
    border: var(--line);
    border-radius: var(--radius);
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color 0.15s var(--ease),
      background-color 0.15s var(--ease);
  }

  .link-card:hover {
    border-color: var(--color-accent);
    background: var(--color-surface-2);
    color: var(--color-text);
  }

  .title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .title svg {
    flex: none;
    color: var(--color-accent);
  }

  .text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
