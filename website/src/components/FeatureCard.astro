---
// One tab of the studio: its number in the tab row, name, what it shows and what that is good for.
interface Props {
  index: number;
  name: string;
  text: string;
  benefit: string;
  href?: string;
}
const { index, name, text, benefit, href } = Astro.props;
const number = String(index).padStart(2, '0');
---

<article class="card">
  <p class="number" aria-hidden="true">{number}</p>
  <h3>{href ? <a href={href}>{name}</a> : name}</h3>
  <p class="text">{text}</p>
  <p class="benefit">{benefit}</p>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-surface);
    border: var(--line);
    border-radius: var(--radius);
    transition: border-color 0.15s var(--ease);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-border-strong);
  }

  .number {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: var(--color-text-dim);
  }

  h3 {
    font-size: var(--text-lg);
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  /* The whole card is the link's target. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  h3 a:focus-visible {
    outline: none;
  }

  .card:has(a:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  .text {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .benefit {
    padding-top: var(--space-3);
    border-top: var(--line);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .benefit::before {
    content: '→ ';
    color: var(--color-accent);
  }
</style>
