---
import { languages, languageNames, useT, type Lang } from '../i18n';
import { pageUrl } from '../lib/urls';

interface Props {
  lang: Lang;
  /** The current page's route, e.g. '/features/': the switch leads to the same page in the other language. */
  path: string;
}
const { lang, path } = Astro.props;
const t = useT(lang);
---

<ul class="lang" aria-label={t.nav.language}>
  {
    languages.map((code) => (
      <li>
        <a
          href={pageUrl(code, path)}
          lang={code}
          hreflang={code}
          title={languageNames[code]}
          aria-current={code === lang ? 'true' : undefined}
        >
          {code.toUpperCase()}
          <span class="visually-hidden">: {languageNames[code]}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .lang {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    border: var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  li + li {
    border-left: var(--line);
  }

  a {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-text);
    background: var(--color-surface-2);
  }

  a[aria-current] {
    color: var(--color-text);
    background: var(--color-surface-2);
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  a:focus-visible {
    outline-offset: -2px;
  }
</style>
