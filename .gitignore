# Build output
bin/
obj/
*.nupkg
TestResults/

# IDE / OS
.vs/
.vscode/
.idea/
*.user
*.suo
.DS_Store
Thumbs.db

# Factorio Mod Studio working folders
.fmstudio/
dist/

# Local workspace for the UI (your mods under development)
/mods/*
!/mods/README.md

# Release builds
publish/
artifacts/

# Logs and local secrets (e.g. factorio.com credentials): never committed
*.log
.env
.env.*

# Local-only developer tooling (code graph for AI agents): kept on disk, not in the repo
/tools/graphify/
/docs/graphify.md
/.graphifyignore
graphify-out/

# Local AI-agent settings with machine-specific paths: never committed
CLAUDE.md
.claude/

# Local backups (e.g. of the web UI before a redesign): never committed
/backups/

# Local sandbox test environment (see .sandbox/): never committed
/.sandbox/

# Nix build output
result
result-*
